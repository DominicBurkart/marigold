async {
    use ::marigold::marigold_impl::*;
    let mut digits = {use ::marigold::marigold_impl::*; ::marigold::marigold_impl::multi_consumer_stream::MultiConsumerStream::new(::marigold::marigold_impl::futures::stream::iter(0..5))};

let mut odd = {use ::marigold::marigold_impl::*; ::marigold::marigold_impl::multi_consumer_stream::MultiConsumerStream::new({ let __marigold_receiver = digits.get(); Box::pin(::marigold::marigold_impl::futures::StreamExt::flatten(::marigold::marigold_impl::futures::stream::once(async move { __marigold_receiver.combinations(2).await.map(|v| <[_; 2]>::try_from(v).unwrap()) }))) })};

let returning_stream_0 = Box::pin({use ::marigold::marigold_impl::*; { let __marigold_receiver = digits.get(); ::marigold::marigold_impl::futures::StreamExt::flatten(::marigold::marigold_impl::futures::stream::once(async move { __marigold_receiver.permutations(2).await.map(|v| <[_; 2]>::try_from(v).unwrap()) })) }});
let returning_stream_1 = Box::pin({use ::marigold::marigold_impl::*; odd.get()});
let stream_variable_runners_0 = Box::pin({
                let runner_future = Box::pin(digits.run());
                ::marigold::marigold_impl::multi_consumer_stream::RunFutureAsStream::new(runner_future)
            });
let stream_variable_runners_1 = Box::pin({
                let runner_future = Box::pin(odd.run());
                ::marigold::marigold_impl::multi_consumer_stream::RunFutureAsStream::new(runner_future)
            });

        /// silly function that uses generics to infer the output type (StreamItem) via generics, so that
        /// we can provide the streams as an array of Pin<Box<dyn Stream<Item=StreamItem>>>.
        #[inline(always)]
        fn typed_stream_vec<StreamItem>(v: Vec<core::pin::Pin<Box<dyn futures::Stream<Item=StreamItem>>>>) -> Vec<core::pin::Pin<Box<dyn futures::Stream<Item=StreamItem>>>> {
         v
        }
        let streams_array = typed_stream_vec(vec![
returning_stream_0,
returning_stream_1,
stream_variable_runners_0,
stream_variable_runners_1,
]
);let mut all_streams = ::marigold::marigold_impl::futures::stream::select_all(streams_array);all_streams
}
