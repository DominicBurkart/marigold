fn start() -> [i64; 64] {
    let edges: [[i64; 3]; 14] = [
        [0, 1, 4], [1, 2, 3], [2, 3, 5], [3, 0, 2], [0, 2, 9], [3, 4, 6], [4, 5, 2],
        [5, 6, 3], [6, 7, 4], [7, 4, 1], [5, 7, 8], [1, 3, 10], [6, 4, 9], [2, 0, 12],
    ];
    let mut dist = [1000000; 64];
    let mut v = 0;
    while v < 8 {
        dist[v * 8 + v] = 0;
        v += 1;
    }
    let mut e = 0;
    while e < 14 {
        dist[edges[e][0] as usize * 8 + edges[e][1] as usize] = edges[e][2];
        e += 1;
    }
    dist
}

fn relax(dist: [i64; 64], k: i32) -> [i64; 64] {
    let mut next = dist;
    let mut i: usize = 0;
    while i < 8 {
        let mut j: usize = 0;
        while j < 8 {
            let through = dist[i * 8 + k as usize] + dist[k as usize * 8 + j];
            if through < next[i * 8 + j] {
                next[i * 8 + j] = through;
            }
            j += 1;
        }
        i += 1;
    }
    next
}

range(0, 8).fold(start, relax).return
